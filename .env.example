# ─────────────────────────────────────────────────────────────────────────────
# AI Email Assistant Harness — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text                   # text | json

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai               # openai | gemini
OPENAI_API_KEY=sk-...             # Required if LLM_PROVIDER=openai
GEMINI_API_KEY=                   # Required if LLM_PROVIDER=gemini

# Model routing (leave blank to use defaults)
LLM_MODEL_DRAFT=gpt-4o            # Complex task: drafting emails
LLM_MODEL_SUMMARIZE=gpt-4o-mini   # Simple task: summarising threads
LLM_MODEL_TRIAGE=gpt-4o-mini      # Simple task: triage classification
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=3

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Option A: Paste the full token JSON as a single env var (for CI/CD / Docker)
# GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.modify"]}

# Option B: Point to credentials and token files (for local development)
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json
GMAIL_USER_EMAIL=me               # Gmail address or "me" for the authenticated user

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./ai_email_assistant.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_email_assistant

SQLALCHEMY_ECHO=false

# ── Cache ─────────────────────────────────────────────────────────────────────
# Leave empty to use InMemoryCache (local dev)
# REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# ── Approval Gate ─────────────────────────────────────────────────────────────
APPROVAL_TIMEOUT_SECONDS=3600     # 1 hour
REVIEWER_EMAIL=                   # Optional: email to notify on new drafts

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./data/audit/audit.jsonl

# ── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this in production!
SECRET_KEY=dev-secret-key-change-in-production

# ── Polling ───────────────────────────────────────────────────────────────────
POLLING_INTERVAL_SECONDS=60